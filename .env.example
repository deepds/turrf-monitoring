# Пример конфигурации. Скопировать в .env и отредактировать.
#
# Бизнес-пороги (покрытие, уверенность, выбросы) здесь НЕ задаются: они живут
# в версионируемом профиле методики. Порог в переменной окружения менял бы
# историю незаметно для расчёта.

# --- хранилища -------------------------------------------------------------
TMO_DB_PASSWORD=смените_меня
TMO_PG_PORT=55432
TMO_REDIS_PORT=56379

# --- внешние порты ---------------------------------------------------------
TMO_UI_PORT=8090
TMO_API_PORT=8091

# --- окружение -------------------------------------------------------------
TMO_ENVIRONMENT=production
TMO_LOG_LEVEL=INFO
TMO_LOG_FORMAT=json

# Список через запятую либо JSON-массив. Оба формата принимаются.
TMO_CORS_ORIGINS=http://localhost:8090

# Пустое значение означает «административные операции выключены»,
# а не «открыты всем».
TMO_ADMIN_TOKEN=

# --- сбор ------------------------------------------------------------------
# Замер 07.08.2026: при 12 одновременных обращениях Туту отвечает 503 и
# размыкатель цепи уносит остаток пачки. Рабочая точка — 8.
TMO_TUTU_CONCURRENCY=8
TMO_RZD_CONCURRENCY=4
TMO_WORKER_CONCURRENCY=8

# --- сборка образа ---------------------------------------------------------
# Заполнять только если pypi.org недоступен из сети развёртывания.
# TMO_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# TMO_PIP_TRUSTED_HOST=mirrors.aliyun.com
